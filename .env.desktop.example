# Desktop client configuration. Do not put LLM provider keys here.
QA_CLOUD_URL=http://127.0.0.1:6060
QA_WEB_URL=http://127.0.0.1:6060
QA_DEVICE_ID=desktop-1
QA_DEVICE_TOKEN=replace-with-the-same-device-token-as-cloud
# Optional: a profile listed by QA_MODEL_PROFILES on the cloud. QA Control can
# test the server and select it interactively; leave empty for server default.
QA_MODEL_PROFILE=
