# Cloud API listener and public address. Use a real hostname to enable the
# Caddy/HTTPS deployment, or leave QA_DOMAIN empty/use an IP for HTTP :6060.
QA_BIND_ADDR=0.0.0.0:6060
QA_DOMAIN=qa.example.com
QA_PUBLIC_PORT=6060

# Initial administrator. The password is only used when the database does not
# have an admin yet; change it after first login. Use at least 12 characters.
QA_ADMIN_USERNAME=admin
QA_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
QA_AUTH_SESSION_HOURS=168
# Keep true behind public HTTPS/Caddy; set false for local http://127.0.0.1.
QA_COOKIE_SECURE=true

# Comma-separated device-id=token entries.
QA_DEVICE_TOKENS=desktop-1=replace-with-a-long-random-device-token
QA_MAX_IMAGE_MB=20
QA_DB_PATH=data/qa-snapshot.db

# LLM keys exist only on the cloud service. vision sends the screenshot to a
# multimodal model; ocr extracts text first and then calls LLM_PROVIDER.
QA_ANALYSIS_MODE=vision
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024

# Qwen vision alternative (replace the four LLM_* values above):
# LLM_PROVIDER=qwen
# LLM_API_KEY=replace-with-dashscope-api-key
# LLM_MODEL=qwen3-vl-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# For a workspace-specific endpoint, /v1 is also accepted:
# LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# DeepSeek V4 Flash Vision direct screenshot-analysis alternative. `deepseek`
# alone defaults to the text-only `deepseek-chat` model, so use this provider
# name (or set LLM_MODEL explicitly) when QA_ANALYSIS_MODE=vision.
# LLM_PROVIDER=deepseek-vision
# LLM_API_KEY=replace-with-deepseek-api-key
# LLM_MODEL=deepseek-v4-flash-vision-exp
# LLM_BASE_URL=https://api.deepseek.com

# Optional multi-model profiles. When QA_MODEL_PROFILES is set, each desktop
# can choose one profile in QA Control; provider keys remain on this server.
# The legacy LLM_* block above remains the one "default" profile when this
# section is omitted.
# QA_MODEL_PROFILES=qwen,deepseek-vision
# QA_DEFAULT_MODEL_PROFILE=qwen
#
# QA_MODEL_QWEN_LABEL='Qwen 3.7 Plus'
# QA_MODEL_QWEN_PROVIDER=qwen
# QA_MODEL_QWEN_API_KEY=replace-with-dashscope-api-key
# QA_MODEL_QWEN_MODEL=qwen3.7-plus
# QA_MODEL_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QA_MODEL_QWEN_ANALYSIS_MODE=vision
# QA_MODEL_QWEN_MAX_TOKENS=1024
#
# QA_MODEL_DEEPSEEK_VISION_LABEL='DeepSeek V4 Flash Vision'
# QA_MODEL_DEEPSEEK_VISION_PROVIDER=deepseek-vision
# QA_MODEL_DEEPSEEK_VISION_API_KEY=replace-with-deepseek-api-key
# QA_MODEL_DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# QA_MODEL_DEEPSEEK_VISION_BASE_URL=https://api.deepseek.com
# QA_MODEL_DEEPSEEK_VISION_ANALYSIS_MODE=vision
# QA_MODEL_DEEPSEEK_VISION_MAX_TOKENS=1024

# OCR -> text LLM alternative:
# QA_ANALYSIS_MODE=ocr
# OCR_API_KEY=replace-with-dashscope-key
# OCR_MODEL=qwen-vl-ocr
# OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# OCR_MAX_TOKENS=4096
# LLM_PROVIDER=deepseek
# LLM_API_KEY=replace-with-deepseek-key
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
