# Cloud API listener and public domain.
QA_BIND_ADDR=0.0.0.0:8080
QA_DOMAIN=qa.example.com

# Initial administrator. The password is only used when the database does not
# have an admin yet; change it after first login. Use at least 12 characters.
QA_ADMIN_USERNAME=admin
QA_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
QA_AUTH_SESSION_HOURS=168
# Keep true behind public HTTPS/Caddy; set false for local http://127.0.0.1.
QA_COOKIE_SECURE=true

# Comma-separated device-id=token entries.
QA_DEVICE_TOKENS=desktop-1=replace-with-a-long-random-device-token
QA_MAX_IMAGE_MB=20
QA_DB_PATH=data/qa-snapshot.db

# LLM keys exist only on the cloud service.
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024

# Qwen vision alternative (replace the four LLM_* values above):
# LLM_PROVIDER=qwen
# LLM_API_KEY=replace-with-dashscope-api-key
# LLM_MODEL=qwen3-vl-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# For a workspace-specific endpoint, /v1 is also accepted:
# LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
